page {
  background: #f7f6f3;
  color: #171717;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 76rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.hero {
  padding: 20rpx 4rpx 18rpx;
}

.eyebrow,
.section-label {
  display: block;
  color: #8a8178;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 12rpx;
  color: #171717;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  display: block;
  margin-top: 18rpx;
  color: #404040;
  font-size: 28rpx;
  line-height: 1.65;
}

.status-card,
.panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #e7e5e4;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.status-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
}

.status-card.ready {
  border-color: #c7d2a8;
}

.status-card.missing {
  border-color: #e7c873;
}

.status-title {
  display: block;
  color: #171717;
  font-size: 32rpx;
  font-weight: 700;
}

.status-desc {
  display: block;
  margin-top: 10rpx;
  color: #57534e;
  font-size: 26rpx;
  line-height: 1.5;
}

.panel-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
  margin-bottom: 26rpx;
}

.section-title {
  display: block;
  margin-top: 8rpx;
  color: #171717;
  font-size: 34rpx;
  font-weight: 700;
}

.field-label {
  margin-bottom: 16rpx;
  color: #404040;
  font-size: 26rpx;
  font-weight: 600;
}

.key-label {
  margin-top: 30rpx;
}

.action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 34rpx;
}

.action-row van-button {
  flex: 1;
}
