page {
  background: #f7f6f3;
  color: #171717;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 76rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.hero {
  padding: 20rpx 4rpx 18rpx;
}

.eyebrow,
.section-label {
  display: block;
  color: #8a8178;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 12rpx;
  color: #171717;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle,
.body,
.notice-body {
  display: block;
  color: #404040;
  font-size: 28rpx;
  line-height: 1.7;
}

.subtitle {
  margin-top: 18rpx;
}

.panel,
.notice {
  margin-top: 24rpx;
  padding: 28rpx;
  border: 2rpx solid #e7e5e4;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.section-title,
.notice-title {
  display: block;
  margin-top: 8rpx;
  margin-bottom: 18rpx;
  color: #171717;
  font-size: 34rpx;
  font-weight: 700;
}

.notice {
  border-color: #e7c873;
  background: #fffaf0;
}

.notice-title {
  margin-top: 0;
}
