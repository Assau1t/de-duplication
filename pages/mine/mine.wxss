page {
  background: #f7f6f3;
  color: #171717;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
}

.page {
  min-height: 100vh;
  padding: 76rpx 28rpx 48rpx;
  box-sizing: border-box;
}

.hero {
  padding: 20rpx 4rpx 18rpx;
}

.eyebrow {
  display: block;
  color: #8a8178;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 0;
  text-transform: uppercase;
}

.title {
  display: block;
  margin-top: 12rpx;
  color: #171717;
  font-size: 50rpx;
  font-weight: 700;
  line-height: 1.2;
}

.subtitle {
  display: block;
  margin-top: 18rpx;
  color: #404040;
  font-size: 28rpx;
  line-height: 1.65;
}

.summary-card,
.action-list {
  margin-top: 24rpx;
  border: 2rpx solid #e7e5e4;
  border-radius: 16rpx;
  background: #ffffff;
  box-sizing: border-box;
}

.summary-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  padding: 28rpx;
}

.summary-title,
.action-title {
  display: block;
  color: #171717;
  font-size: 31rpx;
  font-weight: 700;
}

.summary-desc,
.action-desc {
  display: block;
  margin-top: 10rpx;
  color: #57534e;
  font-size: 25rpx;
  line-height: 1.5;
}

.summary-state {
  flex-shrink: 0;
  min-height: 52rpx;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  color: #171717;
  font-size: 24rpx;
  box-sizing: border-box;
}

.summary-state.ready {
  background: #ecfccb;
  color: #365314;
}

.summary-state.missing {
  background: #fef3c7;
  color: #7c5a00;
}

.action-list {
  overflow: hidden;
}

.action-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 132rpx;
  padding: 24rpx 26rpx;
  border-bottom: 2rpx solid #f1f0ee;
  box-sizing: border-box;
}

.action-item:last-child {
  border-bottom: 0;
}

.action-icon {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 68rpx;
  height: 68rpx;
  border-radius: 12rpx;
  background: #fffaf0;
  color: #171717;
}

.action-copy {
  flex: 1;
}
